{
  "name": "cbs-web-app",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "build:css": "postcss src/styles/index.css -o src/styles/output.css",
    "watch:css": "postcss src/styles/index.css -o src/styles/output.css",
    "start": "npm run watch:css && react-scripts start",
    "build": "npm run build:css && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pre-commit": "lint-staged",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json,css,scss,md} !src/styles/output.css"
  },
  "dependencies": {
    "@babel/plugin-syntax-decorators": "^7.16.7",
    "@draft-js-plugins/editor": "^4.1.1",
    "@draft-js-plugins/emoji": "^4.5.5",
    "@draft-js-plugins/focus": "^4.1.2",
    "@draft-js-plugins/mention": "^5.1.1",
    "@headlessui/react": "^1.3.0",
    "@reduxjs/toolkit": "^1.6.1",
    "@types/draft-js": "^0.11.8",
    "@types/react-lazy-load-image-component": "^1.5.2",
    "@types/uuid": "^8.3.4",
    "axios": "^0.21.1",
    "chart.js": "^3.6.1",
    "chartjs-adapter-moment": "^1.0.0",
    "chartjs-plugin-datalabels": "^2.0.0",
    "classnames": "^2.3.1",
    "compressorjs": "^1.1.1",
    "dhtmlx-gantt": "^7.1.9",
    "draft-js": "^0.11.7",
    "formik": "^2.2.9",
    "html-react-parser": "^1.4.4",
    "i18next": "^20.3.4",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "react": "^17.0.2",
    "react-chartjs-2": "^4.0.0",
    "react-collapse": "^5.1.1",
    "react-datepicker": "^4.5.0",
    "react-day-picker": "^7.4.10",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.11.3",
    "react-id-swiper": "^4.0.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-lazy-load-image-component": "^1.5.1",
    "react-onesignal": "^2.0.2",
    "react-query": "^3.19.0",
    "react-redux": "^7.2.4",
    "react-responsive-carousel": "^3.2.22",
    "react-router": "5.2.1",
    "react-router-dom": "5.2.0",
    "react-scripts": "^4.0.3",
    "react-slick": "^0.28.1",
    "react-toastify": "^7.0.4",
    "react-virtualized": "^9.22.3",
    "react-zoom-pan-pinch": "^2.1.3",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^2.3.0",
    "source-map-explorer": "^2.5.2",
    "swiper": "^6.8.0",
    "uuid": "^8.3.2",
    "web-vitals": "^2.1.0",
    "yup": "^0.32.9"
  },
  "devDependencies": {
    "@babel/plugin-transform-typescript": "^7.16.8",
    "@storybook/addon-actions": "^6.3.4",
    "@storybook/addon-essentials": "^6.3.4",
    "@storybook/addon-links": "^6.3.4",
    "@storybook/node-logger": "^6.3.4",
    "@storybook/preset-create-react-app": "^3.2.0",
    "@storybook/react": "^6.3.4",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^13.2.0",
    "@types/jest": "^26.0.24",
    "@types/lodash": "^4.14.171",
    "@types/node": "^16.3.3",
    "@types/react": "^17.0.14",
    "@types/react-collapse": "^5.0.1",
    "@types/react-datepicker": "^4.3.2",
    "@types/react-dom": "^17.0.9",
    "@types/react-redux": "^7.1.18",
    "@types/react-router-dom": "^5.1.8",
    "@types/react-slick": "^0.23.7",
    "@types/react-virtualized": "^9.21.12",
    "@types/socket.io-client": "1.4.36",
    "@typescript-eslint/eslint-plugin": "^4.28.4",
    "@typescript-eslint/parser": "^4.28.4",
    "autoprefixer": "^10.3.1",
    "eslint-config-prettier": "^8.3.0",
    "husky": "^7.0.1",
    "lint-staged": "^11.0.1",
    "postcss": "^8.3.5",
    "postcss-cli": "^8.3.1",
    "prettier": "^2.3.2",
    "tailwindcss": "^2.2.4",
    "typescript": "^4.3.5"
  },
  "resolutions": {
    "babel-loader": "8.1.0",
    "react-error-overlay": "6.0.9"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "jest": true
    },
    "rules": {
      "no-console": "warn",
      "import/first": "error",
      "react/react-in-jsx-scope": "off",
      "react/prop-types": "off",
      "no-multiple-empty-lines": [
        "error",
        {
          "max": 1,
          "maxEOF": 0,
          "maxBOF": 0
        }
      ]
    },
    "extends": [
      "react-app",
      "react-app/jest",
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react-hooks/recommended",
      "prettier"
    ],
    "overrides": [
      {
        "files": [
          "*.ts",
          "*.tsx"
        ],
        "parserOptions": {
          "ecmaVersion": 11,
          "ecmaFeatures": {
            "jsx": true
          },
          "project": [
            "./tsconfig.json"
          ]
        }
      },
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ],
    "parser": "@typescript-eslint/parser",
    "root": true,
    "plugins": [
      "react",
      "@typescript-eslint"
    ],
    "settings": {
      "react": {
        "pragma": "React",
        "version": "detect"
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md} !src/styles/output.css": [
      "prettier --write"
    ]
  }
}
